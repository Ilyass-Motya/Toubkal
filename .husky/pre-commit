#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# CRITICAL: Block Jest usage (we use Vitest)
echo "🔍 Checking for Jest usage (we use Vitest)..."
JEST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | xargs grep -l 'jest\.' 2>/dev/null || true)
if [ ! -z "$JEST_FILES" ]; then
  echo ""
  echo "❌ ERROR: Found jest.fn(), jest.mock(), or other Jest usage"
  echo ""
  echo "📋 Files with Jest usage:"
  echo "$JEST_FILES" | sed 's/^/  - /'
  echo ""
  echo "ℹ️  FIX: Use Vitest instead:"
  echo "  - Replace: jest.fn() → vi.fn()"
  echo "  - Replace: jest.mock() → vi.mock()"
  echo "  - Import: import { vi } from 'vitest'"
  echo ""
  echo "📖 See QUICK-START.md for testing framework guidance"
  echo ""
  exit 1
fi

# Run lint-staged (only lint changed files)
npx lint-staged

# Validate documentation (only if docs changed)
echo "📚 Checking documentation changes..."
DOC_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(md|xml|txt)$' || true)
if [ ! -z "$DOC_FILES" ]; then
  echo "📝 Found documentation changes, validating..."
  echo "Files: $DOC_FILES"
  npm run validate-docs:strict
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Documentation validation failed"
    echo "💡 Fix issues with: npm run validate-docs:fix"
    echo "📖 See src/scripts/validate-documentation.ts for details"
    exit 1
  else
    echo "✅ Documentation validation passed"
  fi
else
  echo "ℹ️  No documentation changes detected"
fi

# For C++ files, run clang-format (if available)
if command -v clang-format >/dev/null 2>&1; then
  git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cc|h)$' | xargs clang-format -i
  # Re-add formatted files
  git diff --cached --name-only --diff-filter=ACM | xargs git add
else
  echo "clang-format not found, skipping C++ formatting"
fi