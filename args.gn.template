# Toubkal Browser - GN Build Configuration Template
# This file configures the GN build system for Toubkal Browser
# Copy this file to args.gn and customize as needed

# =============================================================================
# BUILD TYPE CONFIGURATION
# =============================================================================

# Build type (true = debug, false = release)
is_debug = true

# Official build flag (set to true for production releases)
is_official_build = false

# Development build (enables additional debugging features)
is_debug_fission = true

# Enable symbol information
symbol_level = 2

# Enable debug information
enable_debugging = true

# =============================================================================
# TARGET PLATFORM CONFIGURATION
# =============================================================================

# Target operating system
# Options: "linux", "mac", "win", "android", "ios"
target_os = "linux"

# Target CPU architecture
# Options: "x64", "arm64", "arm", "mips64el"
target_cpu = "x64"

# Enable 64-bit builds
is_64bit = true

# =============================================================================
# TOUBKAL BROWSER FEATURES
# =============================================================================

# Enable Toubkal AI integration
enable_toubkal_ai = true

# Enable Toubkal privacy features
enable_toubkal_privacy = true

# Enable Toubkal audit logging
enable_toubkal_audit = true

# Enable Toubkal MCP server
enable_toubkal_mcp = true

# Enable Toubkal consent management
enable_toubkal_consent = true

# Enable Toubkal brand compliance
enable_toubkal_brand = true

# =============================================================================
# PRIVACY AND SECURITY CONFIGURATION
# =============================================================================

# Disable all telemetry and data collection
disable_telemetry = true
disable_crash_reporting = true
disable_usage_statistics = true
disable_google_services = true

# Disable Google-specific features
disable_google_services = true
disable_google_analytics = true
disable_google_ads = true
disable_google_safe_browsing = true

# Disable Microsoft-specific features
disable_microsoft_services = true
disable_microsoft_telemetry = true

# Disable other telemetry sources
disable_third_party_telemetry = true
disable_hardware_telemetry = true
disable_network_telemetry = true

# Enable privacy-first defaults
enable_privacy_sandbox = false
enable_federated_learning = false
enable_interest_cohort_api = false

# =============================================================================
# COMPILER AND BUILD OPTIMIZATION
# =============================================================================

# Compiler optimization level
# Options: 0 (none), 1 (basic), 2 (aggressive), 3 (maximum)
optimization_level = 2

# Enable link-time optimization
use_lld = true
use_lto = true

# Enable thin LTO for faster builds
use_thin_lto = true

# Enable PGO (Profile-Guided Optimization)
use_pgo = false

# Enable AFDO (AutoFDO)
use_afdo = false

# =============================================================================
# BUILD SYSTEM CONFIGURATION
# =============================================================================

# Use Ninja build system
use_ninja = true

# Use Goma for distributed compilation
use_goma = true

# Use sccache for compilation caching
use_sccache = true

# Enable incremental builds
enable_incremental_builds = true

# Enable parallel builds
enable_parallel_builds = true

# Number of parallel jobs (0 = auto-detect)
jobs = 0

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Enable unit tests
enable_unit_tests = true

# Enable integration tests
enable_integration_tests = true

# Enable end-to-end tests
enable_e2e_tests = true

# Enable performance tests
enable_performance_tests = true

# Enable security tests
enable_security_tests = true

# Test coverage
enable_test_coverage = true
test_coverage_threshold = 80

# =============================================================================
# RUNTIME CONFIGURATION
# =============================================================================

# Enable V8 JavaScript engine
enable_v8 = true

# Enable Blink rendering engine
enable_blink = true

# Enable Skia graphics engine
enable_skia = true

# Enable WebRTC
enable_webrtc = true

# Enable WebAssembly
enable_wasm = true

# Enable WebGPU
enable_webgpu = true

# =============================================================================
# NETWORK AND SECURITY
# =============================================================================

# Enable network monitoring
enable_network_monitoring = true

# Enable network request logging
enable_network_logging = true

# Enable security logging
enable_security_logging = true

# Enable audit logging
enable_audit_logging = true

# =============================================================================
# PLATFORM-SPECIFIC CONFIGURATION
# =============================================================================

# Linux-specific settings
if (target_os == "linux") {
  # Use system libraries where possible
  use_system_libcxx = true
  use_system_harfbuzz = true
  use_system_libjpeg = true
  use_system_libpng = true
  use_system_zlib = true
  
  # Enable Wayland support
  use_wayland = true
  
  # Enable X11 support
  use_x11 = true
  
  # Enable GTK3 support
  use_gtk = true
}

# macOS-specific settings
if (target_os == "mac") {
  # Enable macOS-specific features
  enable_mac_native_notifications = true
  enable_mac_native_menus = true
  
  # Use system libraries
  use_system_libcxx = true
  
  # Enable Metal support
  enable_metal = true
  
  # Enable Core Animation
  enable_core_animation = true
}

# Windows-specific settings
if (target_os == "win") {
  # Enable Windows-specific features
  enable_win_native_notifications = true
  enable_win_native_menus = true
  
  # Use Visual Studio compiler
  is_clang = false
  
  # Enable DirectX support
  enable_directx = true
  
  # Enable Windows Media Foundation
  enable_wmf = true
}

# =============================================================================
# DEBUGGING AND DEVELOPMENT
# =============================================================================

# Enable debugging features
enable_debugging = true
enable_debug_symbols = true
enable_debug_info = true

# Enable logging
enable_logging = true
log_level = "INFO"

# Enable assertions
enable_assertions = true
enable_dchecks = true

# Enable tracing
enable_tracing = true
enable_perfetto = true

# =============================================================================
# PERFORMANCE AND MEMORY
# =============================================================================

# Enable memory optimization
enable_memory_optimization = true
enable_memory_pressure_handling = true

# Enable performance optimization
enable_performance_optimization = true
enable_cpu_optimization = true

# Enable GPU acceleration
enable_gpu_acceleration = true
enable_hardware_acceleration = true

# =============================================================================
# INTERNATIONALIZATION
# =============================================================================

# Enable internationalization
enable_i18n = true

# Default locale
default_locale = "en-US"

# Supported locales
supported_locales = [
  "en-US",
  "en-GB", 
  "fr-FR",
  "de-DE",
  "es-ES",
  "it-IT",
  "pt-BR",
  "ja-JP",
  "ko-KR",
  "zh-CN",
  "zh-TW",
  "ru-RU",
  "ar-SA",
  "hi-IN",
]

# =============================================================================
# CUSTOM TOUBKAL CONFIGURATION
# =============================================================================

# Toubkal Browser version
toubkal_version = "1.0.0"

# Toubkal Browser build type
toubkal_build_type = "development"

# Toubkal Browser features
toubkal_features = {
  "ai_integration": true,
  "privacy_dashboard": true,
  "audit_logging": true,
  "mcp_server": true,
  "consent_management": true,
  "brand_compliance": true,
  "zero_telemetry": true,
}

# Toubkal Browser security
toubkal_security = {
  "disable_telemetry": true,
  "disable_crash_reporting": true,
  "disable_usage_statistics": true,
  "disable_google_services": true,
  "network_monitoring": true,
  "privacy_first": true,
}

# Toubkal Browser build
toubkal_build = {
  "use_goma": true,
  "use_sccache": true,
  "enable_ninja": true,
  "deterministic_builds": true,
  "reproducible_builds": true,
}

# =============================================================================
# VALIDATION AND VERIFICATION
# =============================================================================

# Enable build validation
enable_build_validation = true

# Enable security validation
enable_security_validation = true

# Enable privacy validation
enable_privacy_validation = true

# Enable performance validation
enable_performance_validation = true

# =============================================================================
# END OF CONFIGURATION
# =============================================================================