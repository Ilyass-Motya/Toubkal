{
  "name": "toubkal-browser",
  "version": "0.0.5",
  "type": "module",
  "description": "Chromium-based privacy-first AI browser with local inference, zero telemetry, and cryptographically verifiable audit trail",
  "main": "index.js",
  "homepage": "https://github.com/Ilyass-Motya/Toubkal",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ilyass-Motya/Toubkal.git"
  },
  "bugs": {
    "url": "https://github.com/Ilyass-Motya/Toubkal/issues"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --coverage --reporter=json --outputFile=test-report.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0 --ignore-pattern 'node_modules/**' --ignore-pattern 'out/**' --ignore-pattern 'build/**' || echo 'No TypeScript files found to lint'",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --ignore-pattern 'node_modules/**' --ignore-pattern 'out/**' --ignore-pattern 'build/**'",
    "lint:ci": "eslint . --ext .ts,.tsx --format json --output-file eslint-report.json --ignore-pattern 'node_modules/**' --ignore-pattern 'out/**' --ignore-pattern 'build/**'",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "validate-docs": "tsx src/scripts/validate-documentation.ts",
    "validate-docs:fix": "tsx src/scripts/validate-documentation.ts --fix",
    "validate-docs:strict": "tsx src/scripts/validate-documentation.ts --strict",
    "generate-doc-template": "tsx src/scripts/generate-doc-template.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{cc,h}": [
      "clang-format -i"
    ]
  },
  "keywords": [
    "browser",
    "chromium",
    "privacy",
    "ai",
    "local-ai",
    "ollama",
    "mcp",
    "model-context-protocol",
    "zero-telemetry",
    "audit-trail",
    "cryptography",
    "ed25519",
    "privacy-first",
    "open-source"
  ],
  "author": "Ilyass Motya",
  "license": "MPL-2.0",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.6",
    "jsdom": "^23.0.0",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.20.6",
    "typescript": "^5.5.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.546.0"
  }
}
