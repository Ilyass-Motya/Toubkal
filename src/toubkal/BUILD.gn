import("//build/config/compiler/compiler.gni")

# Main Toubkal Browser build configuration
group("toubkal") {
  deps = [
    ":browser",
    ":mojo",
    ":common",
  ]
}

# Browser components
group("browser") {
  deps = [
    ":toubkal_browser",
    ":branding",
    ":ui",
    ":security",
    ":privacy",
    ":common",
  ]
}

# Branding components
group("branding") {
  deps = [
    "//toubkal/browser/branding",
    "//toubkal/common",
  ]
}

# UI components
group("ui") {
  deps = [
    "//toubkal/browser/ui/webui",
    "//toubkal/common",
  ]
}

# Security components
group("security") {
  deps = [
    "//toubkal/browser/security",
    "//toubkal/common",
  ]
}

# Privacy components
group("privacy") {
  deps = [
    "//toubkal/browser/privacy",
    "//toubkal/common",
  ]
}

# Mojo interfaces
group("mojo") {
  deps = [
    "//toubkal/mojo/ui",
    "//toubkal/common",
  ]
}

# Common components
group("common") {
  deps = [
    "//toubkal/common",
  ]
}
