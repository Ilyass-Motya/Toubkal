# Toubkal Browser Privacy Module BUILD.gn
#
# Build configuration for privacy protection components including
# fingerprinting protection, tracker blocking, and Brave Shields integration.

import("//build/config/features.gni")
import("//mojo/public/tools/bindings/mojom.gni")

# Generate Mojo bindings for privacy interfaces
mojom("privacy") {
  sources = [
    "//toubkal/common/privacy.mojom",
  ]
  
  public_deps = [
    "//mojo/public/mojom/base",
  ]
}

# Privacy Manager Library
source_set("privacy_manager") {
  sources = [
    "privacy_manager.cc",
    "privacy_manager.h",
  ]
  
  deps = [
    ":fingerprinting_protection",
    ":tracker_blocker", 
    ":brave_shields_manager",
    "//base",
    "//crypto",
    "//mojo/public/cpp/bindings",
    "//net/base",
    ":privacy",
  ]
  
  public_deps = [
    ":privacy",
  ]
}

# Fingerprinting Protection Library
source_set("fingerprinting_protection") {
  sources = [
    "fingerprinting_protection.cc",
    "fingerprinting_protection.h",
  ]
  
  deps = [
    "//base",
    "//mojo/public/cpp/bindings",
    ":privacy",
  ]
  
  public_deps = [
    ":privacy",
  ]
}

# Tracker Blocker Library
source_set("tracker_blocker") {
  sources = [
    "tracker_blocker.cc",
    "tracker_blocker.h",
  ]
  
  deps = [
    "//base",
    "//net/base",
    "//mojo/public/cpp/bindings",
    "//toubkal/common/privacy",
  ]
  
  public_deps = [
    ":privacy",
  ]
}

# Brave Shields Manager Library
source_set("brave_shields_manager") {
  sources = [
    "brave_shields_manager.cc",
    "brave_shields_manager.h",
  ]
  
  deps = [
    "//base",
    "//mojo/public/cpp/bindings",
    ":privacy",
  ]
  
  public_deps = [
    ":privacy",
  ]
}

# Privacy Module (combines all components)
source_set("privacy") {
  sources = []
  
  deps = [
    ":privacy_manager",
    ":fingerprinting_protection",
    ":tracker_blocker",
    ":brave_shields_manager",
  ]
  
  public_deps = [
    ":privacy",
  ]
}

# Unit Tests
test("privacy_manager_unittests") {
  sources = [
    "privacy_manager_test.cc",
  ]
  
  deps = [
    ":privacy_manager",
    "//base/test:test_support",
    "//testing/gtest",
    "//mojo/public/cpp/bindings",
  ]
  
  data_deps = [
    ":privacy",
  ]
}

