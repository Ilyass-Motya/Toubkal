import("//build/config/compiler/compiler.gni")

source_set("logging") {
  sources = [
    "logger.cc",
    "logger.h",
  ]

  public_deps = [
    "//base",
  ]

  deps = [
    "//base:base",
    "//base:base_static",
  ]

  defines = []
  cflags = []
  cflags_cc = []
  cflags_c = []

  # Enable structured logging in debug builds
  if (is_debug) {
    defines += [ "TOUBKAL_STRUCTURED_LOGGING=1" ]
  }
}

# Test target for logging components
test("logging_unittests") {
  sources = [
    "logger_test.cc",
  ]

  deps = [
    ":logging",
    "//base:base",
    "//base:base_static",
    "//base/test:test_support",
    "//testing/gtest",
  ]

  defines = []
  cflags = []
  cflags_cc = []
  cflags_c = []
}