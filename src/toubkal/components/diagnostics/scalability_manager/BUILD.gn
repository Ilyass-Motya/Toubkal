# Scalability Manager Build Configuration
# 
# Builds the C++ scalability management system for Toubkal Browser diagnostics.

import("//build/config/compiler/compiler.gni")

static_library("scalability_manager") {
  sources = [
    "scalability_manager.h",
    "scalability_manager.cc",
  ]

  public_deps = [
    "//base",
    "//base:base_static",
    "//toubkal/components/diagnostics/logging:logging",
  ]

  deps = [
    "//base",
    "//base:base_static",
    "//toubkal/components/diagnostics/logging:logging",
  ]

  # Include directories
  include_dirs = [
    "//toubkal/components/diagnostics",
    "//toubkal/components/diagnostics/scalability_manager",
    "//toubkal/components/diagnostics/logging",
  ]

  # Compiler flags
  cflags = [
    "-std=c++17",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]

  cflags_cc = [
    "-std=c++17",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]

  # Define macros
  defines = [
    "TOUBKAL_SCALABILITY_MANAGER_IMPLEMENTATION",
  ]
}

# Test target for scalability manager
test("scalability_manager_test") {
  sources = [
    "scalability_manager_test.cc",
  ]

  deps = [
    ":scalability_manager",
    "//base",
    "//base:base_static",
    "//base/test:test_support",
    "//testing/gtest",
    "//toubkal/components/diagnostics/logging:logging",
  ]

  include_dirs = [
    "//toubkal/components/diagnostics",
    "//toubkal/components/diagnostics/scalability_manager",
    "//toubkal/components/diagnostics/logging",
  ]

  cflags = [
    "-std=c++17",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]

  cflags_cc = [
    "-std=c++17",
    "-Wall",
    "-Wextra",
    "-Werror",
  ]

  defines = [
    "TOUBKAL_SCALABILITY_MANAGER_IMPLEMENTATION",
  ]
}
